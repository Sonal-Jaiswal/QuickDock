# QuickDock release configuration — the single place for identifiers and public links.
# Read by scripts/build-app.sh and scripts/make-dmg.sh.
#
# Leave a link empty to hide it in the app's About screen. Never put
# placeholder or unverified URLs here: whatever you set is shown to users.

# Reverse-DNS bundle identifier. Do NOT change it after the first public release:
# preferences, the sandbox container and file permissions are tied to it.
BUNDLE_ID="io.github.sonal-jaiswal.QuickDock"

# Public GitHub repository, e.g. https://github.com/OWNER/QuickDock (https only).
REPO_URL=""

# Public website, e.g. https://OWNER.github.io/QuickDock (https only).
WEBSITE_URL=""

# Support e-mail shown in About. Optional.
SUPPORT_EMAIL=""

# Copyright holder shown in Finder's Get Info.
COPYRIGHT_HOLDER="The QuickDock Authors"
