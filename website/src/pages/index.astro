---
import Base from "../layouts/Base.astro";
import DownloadButton from "../components/DownloadButton.astro";
import {
  site, asset, repoUrl, releasesUrl, checksumUrl, issuesUrl, donationUrl, formatBytes,
} from "../config/site";

const repo = repoUrl();
const releases = releasesUrl();
const checksum = checksumUrl();
const issues = issuesUrl();
const donate = donationUrl();
const r = site.release;
const fileSize = formatBytes(r.sizeBytes);
const d = site.donation;
const progress = d.raisedUSD !== null ? Math.min(100, Math.round((d.raisedUSD / d.goalUSD) * 100)) : null;

const icon = (path: string) =>
  `<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">${path}</svg>`;

const features = [
  { title: "One-click access", text: "Open a floating launcher from anywhere and start what you need with a single click or the Return key.",
    tint: "from-blue-500 to-blue-600", svg: icon('<path d="M9 9l10 4-4 2-2 4z"/><path d="M5 3v3M3 5h3M5.6 8.4 4 10"/>') },
  { title: "Apps, files and folders", text: "Pin the applications, documents and folders you reach for every day — with their real macOS icons.",
    tint: "from-orange-400 to-orange-500", svg: icon('<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>') },
  { title: "Websites and shortcuts", text: "Add websites, copy saved text snippets, start a new email, or jump to Mission Control and System Settings.",
    tint: "from-teal-400 to-teal-500", svg: icon('<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>') },
  { title: "Global keyboard shortcut", text: "Press ⌥ Space (or any shortcut you choose) in any app. No Accessibility permission needed.",
    tint: "from-purple-500 to-purple-600", svg: icon('<rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 14h10"/>') },
  { title: "Personal organization", text: "Instant search, filters for apps, files, folders, web and actions, favorites, categories and drag-and-drop order.",
    tint: "from-pink-500 to-rose-500", svg: icon('<path d="M4 6h16M7 12h10M10 18h4"/>') },
  { title: "Quick Wheel", text: "Hold ⌃⌥Tab, flick towards an app and let go — open it or switch to it in a split second, like a game’s weapon wheel.",
    tint: "from-indigo-500 to-indigo-600", svg: icon('<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><path d="M12 3v6M12 15v6M3 12h6M15 12h6"/>') },
  { title: "Clipboard history", text: "Opt in to keep recent copied text beside the wheel. Click to copy it again; pin what you reuse. Password-manager copies are never saved.",
    tint: "from-amber-400 to-amber-500", svg: icon('<rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4h6v3H9zM9 12h6M9 16h4"/>') },
  { title: "Offline and private by design", text: "No account, no cloud, no analytics, no ads. QuickDock runs in the App Sandbox without network access.",
    tint: "from-green-500 to-emerald-600", svg: icon('<path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z"/><path d="M9 12l2 2 4-4"/>') },
];

const shots = [
  { src: "wheel-light.png", alt: "The Quick Wheel in Light Mode with the clipboard panel", caption: "Quick Wheel in Light Mode" },
  { src: "settings-wheel.png", alt: "Wheel and clipboard settings: shortcut, slots, clipboard history options", caption: "Wheel & clipboard settings" },
  { src: "launcher-light.png", alt: "The QuickDock launcher in Light Mode showing apps, websites and actions", caption: "Light Mode" },
  { src: "search-dark.png", alt: "Searching QuickDock for “no” shows Notes and other matches", caption: "Instant search" },
  { src: "favorites-dark.png", alt: "The Favorites filter showing four pinned items", caption: "Favorites" },
  { src: "settings-launcher.png", alt: "QuickDock settings: grid columns, rows, icon size and labels", caption: "Customize the grid" },
  { src: "settings-shortcuts.png", alt: "QuickDock keyboard shortcut settings", caption: "Your own global shortcut" },
  { src: "settings-organization.png", alt: "QuickDock organization settings with the item list and categories", caption: "Organize items and categories" },
  { src: "editor.png", alt: "The Add Website window with name, address, category and icon options", caption: "Add websites and actions" },
  { src: "onboarding.png", alt: "The QuickDock welcome screen", caption: "A friendly first launch" },
  { src: "settings-data.png", alt: "QuickDock data settings for export, import and reset", caption: "Export, import and reset" },
];

const privacy = [
  ["No account", "There’s nothing to sign up for."],
  ["No cloud sync", "Your items stay in a file on your Mac."],
  ["No advertising", "Never. QuickDock is ad-free."],
  ["No telemetry", "No analytics, crash reporting or tracking of any kind."],
  ["Local storage", "Items and settings live in QuickDock’s own sandbox container."],
  ["No paid APIs", "Everything works offline, with no services behind it."],
];

const faqs: [string, string][] = [
  ["Is QuickDock free?", "Yes. QuickDock is free, open source under the MIT License, and has no subscriptions, in-app purchases or ads. Donations are entirely optional."],
  ["Does it work offline?", "Yes, completely. QuickDock has no network access at all — the app is sandboxed without the network entitlement. Websites you add open in your own browser."],
  ["Which Macs are supported?", `Macs with Apple silicon (M-series) running ${r.minimumMacOS} or later. Intel Macs aren’t supported by the current build; a universal build may follow later.`],
  ["Is it signed and notarized?", "Not yet. QuickDock doesn’t have an Apple Developer ID yet, so current builds are not signed with a Developer ID certificate and are not notarized by Apple. They are not Apple-verified. Joining the Apple Developer Program ($99/year) is what donations are funding."],
  ["Why does macOS show a warning?", "Gatekeeper warns about apps that aren’t notarized by Apple. That’s expected for this early build. You can allow QuickDock once in System Settings › Privacy & Security › Open Anyway (see Installation). Only do this for a copy downloaded from the official GitHub Releases page, and check its SHA-256 checksum."],
  ["How can I donate?", "Use the button in the Support section. Donations are voluntary, go towards Apple Developer Program membership and ongoing work, and don’t buy a subscription or guarantee any feature."],
  ["How do I uninstall it?", "Quit QuickDock from its menu-bar icon (right-click › Quit), drag QuickDock from Applications to the Trash, and optionally delete its data folder. Full steps are in the Uninstall section."],
  ["Can clipboard history see my passwords?", "Clipboard history is off until you turn it on. QuickDock keeps only text, only on your Mac, and skips copies that password managers mark as private. macOS may ask once whether QuickDock can read the clipboard, and you can change that answer in System Settings. History is cleared when you quit unless you choose to remember it."],
  ["Does QuickDock need special permissions?", "No. It doesn’t ask for Accessibility, Full Disk Access, Screen Recording or Automation. It can only open files and folders you choose yourself."],
];
---
<Base>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-6xl px-5 pt-16 pb-12 text-center sm:pt-24">
      <img src={asset("icon-512.png")} alt="QuickDock app icon" width="112" height="112" class="mx-auto drop-shadow-2xl" />
      <p class="mt-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-white/70">
        <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
        Early access {r.version} · free for macOS
      </p>
      <h1 class="section-title mx-auto mt-5 max-w-3xl text-5xl font-semibold text-white sm:text-6xl">{site.tagline}</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-white/65">
        QuickDock is a lightweight floating launcher for the apps, files, folders, websites and actions you use most.
        Press <kbd>⌥</kbd> <kbd>Space</kbd> anywhere, click, and get back to work.
      </p>
      <div class="mt-8 flex flex-col items-center gap-3">
        <div class="flex flex-wrap items-center justify-center gap-3">
          <DownloadButton size="lg" />
          {repo && <a href={repo} class="rounded-full border border-white/15 px-6 py-3 text-base font-medium text-white/85 transition hover:bg-white/5">View on GitHub</a>}
        </div>
        <p class="text-sm text-white/45">{r.minimumMacOS} or later · {r.architectures}{fileSize ? ` · ${fileSize}` : ""} · Unsigned early-access build</p>
      </div>
    </div>
    <figure class="mx-auto max-w-5xl px-5">
      <div class="backdrop-desktop rounded-3xl border border-white/10 p-6 shadow-2xl sm:p-14">
        <img src={asset("screenshots/launcher-dark.png")} width="1248" height="960" loading="eager"
             alt="The QuickDock launcher in Dark Mode: a search field, filters, and a grid of apps, websites and actions"
             class="mx-auto w-full max-w-3xl drop-shadow-[0_30px_60px_rgba(0,0,0,0.6)]" />
      </div>
      <figcaption class="mt-3 text-center text-xs text-white/40">Actual screenshot of QuickDock {r.version} on macOS. The colourful backdrop is decoration added by this website.</figcaption>
    </figure>
  </section>

  <!-- Features -->
  <section id="features" class="mx-auto max-w-6xl px-5 pt-28">
    <div class="max-w-2xl">
      <h2 class="section-title text-3xl font-semibold text-white sm:text-4xl">Everything you reach for, in one place.</h2>
      <p class="mt-4 text-white/60">QuickDock isn’t a search engine for your whole Mac. It’s a personal collection of the things you open every day — and it stays out of your way until you need it.</p>
    </div>
    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {features.map((f) => (
        <li class="glass rounded-2xl p-6">
          <span class={`inline-flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-b text-white shadow-lg ${f.tint}`} set:html={f.svg} />
          <h3 class="mt-4 text-lg font-semibold text-white">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/60">{f.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Quick Wheel -->
  <section id="wheel" class="mx-auto max-w-6xl px-5 pt-28">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.35fr]">
      <div>
        <p class="text-sm font-medium text-indigo-300">New in 0.9</p>
        <h2 class="section-title mt-2 text-3xl font-semibold text-white sm:text-4xl">The Quick Wheel</h2>
        <p class="mt-4 text-white/65">Your favourite apps in a ring around the pointer. It’s the fastest way to jump between the apps you live in.</p>
        <ul class="mt-6 space-y-3 text-sm text-white/70">
          <li class="flex gap-3"><kbd>⌃</kbd><kbd>⌥</kbd><kbd>Tab</kbd><span><strong class="text-white">Hold, flick, release.</strong> Point towards an app and let go to open it — or switch to it if it’s already running.</span></li>
          <li class="flex gap-3"><span class="text-indigo-300">●</span><span><strong class="text-white">Favorites first, then your most-used apps</strong>, with a dot on apps that are running.</span></li>
          <li class="flex gap-3"><span class="text-indigo-300">●</span><span><strong class="text-white">Tap to click instead</strong>, press <kbd>Tab</kbd> again to step through slots, or press <kbd>1</kbd>–<kbd>9</kbd>.</span></li>
          <li class="flex gap-3"><span class="text-indigo-300">●</span><span><strong class="text-white">Clipboard on the side</strong> (optional): recent copied text, one click to copy again.</span></li>
        </ul>
      </div>
      <figure>
        <div class="backdrop-desktop rounded-3xl border border-white/10 p-5 sm:p-8">
          <img src={asset("screenshots/wheel-dark.png")} width="1520" height="880" loading="lazy"
               alt="The QuickDock Quick Wheel: eight apps in a ring with Safari highlighted, next to a clipboard history panel"
               class="w-full" />
        </div>
        <figcaption class="mt-3 text-xs text-white/40">Rendered directly from the QuickDock {r.version} interface. On screen, the wheel and panel are translucent glass that blurs whatever is behind them.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Screenshots -->
  <section id="screenshots" class="mx-auto max-w-6xl px-5 pt-28">
    <h2 class="section-title text-3xl font-semibold text-white sm:text-4xl">See it in action</h2>
    <p class="mt-4 max-w-2xl text-white/60">Real screenshots of QuickDock {r.version}, captured from the running app. Select one to view it full size.</p>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {shots.map((s) => (
        <li>
          <figure>
            <a href={asset(`screenshots/${s.src}`)} class="block rounded-2xl border border-white/10 bg-white/[0.03] p-3 transition hover:border-white/25">
              <img src={asset(`screenshots/${s.src}`)} alt={s.alt} loading="lazy" class="w-full rounded-xl" />
            </a>
            <figcaption class="mt-2.5 text-sm text-white/60">{s.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>

  <!-- Install -->
  <section id="install" class="mx-auto max-w-6xl px-5 pt-28">
    <h2 class="section-title text-3xl font-semibold text-white sm:text-4xl">Installation</h2>
    <div class="mt-6 rounded-2xl border border-amber-400/25 bg-amber-400/[0.06] p-5 text-sm leading-relaxed text-amber-50/90">
      <strong class="text-amber-200">Please read: this is an unsigned early-access build.</strong>
      QuickDock {r.version} is not signed with an Apple Developer ID and has not been notarized by Apple, so it isn’t Apple-verified.
      macOS will block it the first time you open it. The steps below show how to allow just QuickDock, once.
      You never need to turn off Gatekeeper for your whole Mac — please don’t.
    </div>

    <ol class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {[
        ["Download", `Download ${r.fileName} from the official GitHub Releases page.`],
        ["Open the DMG", "Double-click the downloaded file to open the QuickDock disk image."],
        ["Move to Applications", "Drag QuickDock onto the Applications folder shortcut, then eject the disk image."],
        ["Open QuickDock", "Open it from Applications. The first time, follow the security steps below."],
      ].map(([title, text], index) => (
        <li class="glass rounded-2xl p-5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-sm font-semibold text-white">{index + 1}</span>
          <h3 class="mt-3 font-semibold text-white">{title}</h3>
          <p class="mt-1.5 text-sm text-white/60">{text}</p>
        </li>
      ))}
    </ol>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <div class="glass rounded-2xl p-6">
        <h3 class="text-lg font-semibold text-white">First launch on macOS 15 Sequoia and later</h3>
        <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm text-white/70">
          <li>Open QuickDock. macOS says it can’t verify that the app is free of malware. Click <strong>Done</strong> (don’t move it to the Trash).</li>
          <li>Open <strong>System Settings › Privacy &amp; Security</strong>.</li>
          <li>Scroll to <strong>Security</strong>. Next to the message about QuickDock, click <strong>Open Anyway</strong>.</li>
          <li>Enter your password, then click <strong>Open Anyway</strong> again in the final dialog.</li>
        </ol>
        <p class="mt-4 text-xs text-white/45">The “Open Anyway” button appears for about an hour after you first tried to open the app. If it’s missing, open QuickDock again and come back.</p>
      </div>
      <div class="glass rounded-2xl p-6">
        <h3 class="text-lg font-semibold text-white">First launch on macOS 13 Ventura and 14 Sonoma</h3>
        <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm text-white/70">
          <li>In Finder, open <strong>Applications</strong>.</li>
          <li><strong>Control-click</strong> (or right-click) QuickDock and choose <strong>Open</strong>.</li>
          <li>Click <strong>Open</strong> in the dialog that appears.</li>
        </ol>
        <p class="mt-4 text-sm text-white/60">The Privacy &amp; Security › Open Anyway method above also works on these versions.</p>
        <p class="mt-4 text-sm text-white/60">After this, QuickDock opens normally. Look for its icon in the menu bar and press <kbd>⌥</kbd> <kbd>Space</kbd>.</p>
      </div>
    </div>

    <div class="glass mt-6 rounded-2xl p-6">
      <h3 class="text-lg font-semibold text-white">Verify your download (recommended)</h3>
      <p class="mt-2 text-sm text-white/60">Compare the file’s SHA-256 checksum with the one published on the release page{checksum ? "" : " once it’s published"}. In Terminal:</p>
      <pre class="mt-3 overflow-x-auto rounded-xl bg-black/40 p-4 text-sm text-white/80"><code>shasum -a 256 ~/Downloads/{r.fileName}</code></pre>
      {r.sha256 && <p class="mt-3 break-all text-xs text-white/50">Expected for {r.version}: <code class="text-white/75">{r.sha256}</code></p>}
      {checksum && <p class="mt-2 text-xs"><a class="text-[var(--color-accent)] hover:underline" href={checksum}>Download the .sha256 file</a></p>}
    </div>

    <h3 id="troubleshooting" class="mt-14 text-xl font-semibold text-white">Troubleshooting</h3>
    <div class="mt-4 divide-y divide-white/5 rounded-2xl border border-white/10">
      {[
        ["“QuickDock is damaged and can’t be opened”", "This usually means the download was incomplete or altered. Delete it, download it again from the official GitHub Releases page, and check the SHA-256 checksum. Don’t run commands from the internet that promise to “fix” this."],
        ["There’s no “Open Anyway” button", "It only appears after you’ve tried to open QuickDock, and only for a while. Open QuickDock from Applications once, then go straight to System Settings › Privacy & Security."],
        ["I can’t find QuickDock after opening it", "QuickDock lives in the menu bar, not the Dock. Look for its icon near the clock, or press ⌥ Space. On a crowded menu bar, icons can be hidden behind the notch — quit an app or two, or use the shortcut."],
        ["The shortcut doesn’t work", "Another app may already use it. Open QuickDock’s Settings › Shortcuts — it shows whether the shortcut is active — and record a different one, such as ⌃⌥Space or ⌘⇧Space."],
        ["An item shows a warning badge", "The file moved, was deleted, or its disk isn’t connected — or an app was uninstalled. Click it and choose Locate… to point QuickDock at its new location, or Remove."],
        ["“Open at login” asks for approval", "macOS needs you to allow QuickDock in System Settings › General › Login Items. QuickDock shows a button that takes you there."],
      ].map(([q, a]) => (
        <details class="group px-5 py-4">
          <summary class="flex items-center justify-between gap-4 font-medium text-white/90">{q}<span class="chevron text-white/40 transition">›</span></summary>
          <p class="mt-3 text-sm leading-relaxed text-white/60">{a}</p>
        </details>
      ))}
    </div>

    <div id="uninstall" class="glass mt-14 rounded-2xl p-6">
      <h3 class="text-xl font-semibold text-white">Uninstall</h3>
      <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm text-white/70">
        <li>Quit QuickDock: right-click its menu-bar icon and choose <strong>Quit QuickDock</strong>.</li>
        <li>If you turned on <em>Open QuickDock at login</em>, turn it off in QuickDock’s Settings first (or remove it later in System Settings › General › Login Items).</li>
        <li>Drag <strong>QuickDock</strong> from Applications to the Trash.</li>
        <li>Optional — remove your items and settings: in Finder choose <strong>Go › Go to Folder…</strong>, enter <code>~/Library/Containers/</code> and move the <code>io.github.sonal-jaiswal.QuickDock</code> folder to the Trash.</li>
      </ol>
      <p class="mt-4 text-sm text-white/55">QuickDock doesn’t install helpers, kernel extensions or background services, so that’s everything.</p>
    </div>
  </section>

  <!-- Download -->
  <section id="download" class="mx-auto max-w-6xl px-5 pt-28">
    <div class="glass grid gap-10 rounded-3xl p-8 sm:p-10 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <h2 class="section-title text-3xl font-semibold text-white">Download QuickDock</h2>
        <dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-4 text-sm">
          <div><dt class="text-white/45">Latest version</dt><dd class="mt-0.5 font-medium text-white">{r.version} (early access)</dd></div>
          <div><dt class="text-white/45">Released</dt><dd class="mt-0.5 font-medium text-white">{new Date(r.date + "T12:00:00Z").toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</dd></div>
          <div><dt class="text-white/45">Requires</dt><dd class="mt-0.5 font-medium text-white">{r.minimumMacOS} or later</dd></div>
          <div><dt class="text-white/45">Compatibility</dt><dd class="mt-0.5 font-medium text-white">{r.architectures}</dd></div>
          {fileSize && <div><dt class="text-white/45">File size</dt><dd class="mt-0.5 font-medium text-white">{fileSize} (DMG)</dd></div>}
          <div><dt class="text-white/45">Signing</dt><dd class="mt-0.5 font-medium text-amber-200">{r.signed ? "Developer ID signed & notarized" : "Unsigned · not notarized"}</dd></div>
        </dl>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <DownloadButton />
          {releases && <a href={releases} class="text-sm text-white/70 underline-offset-4 hover:underline">All releases on GitHub</a>}
        </div>
      </div>
      <div>
        <h3 class="font-semibold text-white">What’s in {r.version}</h3>
        {r.notes.length > 0 ? (
          <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-white/65">
            {r.notes.map((note: string) => <li>{note}</li>)}
          </ul>
        ) : (
          <p class="mt-3 text-sm text-white/55">See the release notes on GitHub.</p>
        )}
      </div>
    </div>
  </section>

  <!-- Support / donations -->
  <section id="support" class="mx-auto max-w-6xl px-5 pt-28">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="section-title text-3xl font-semibold text-white sm:text-4xl">Help us bring QuickDock to more Mac users.</h2>
        <p class="mt-5 text-white/65">
          QuickDock is built independently, without subscriptions, advertisements, or paid APIs. We are currently self-funding
          development and working towards Apple Developer Program membership so we can sign and notarize future releases.
        </p>
        <p class="mt-5 text-white/65">Your voluntary contribution helps cover:</p>
        <ul class="mt-3 space-y-2 text-white/70">
          <li class="flex gap-3"><span class="text-[var(--color-accent)]">•</span>Apple’s $99/year Developer Program membership.</li>
          <li class="flex gap-3"><span class="text-[var(--color-accent)]">•</span>Code signing and notarization-related release work.</li>
          <li class="flex gap-3"><span class="text-[var(--color-accent)]">•</span>Testing and compatibility improvements.</li>
          <li class="flex gap-3"><span class="text-[var(--color-accent)]">•</span>Future maintenance and development.</li>
        </ul>
      </div>
      <div class="glass self-start rounded-3xl p-8">
        <p class="text-sm text-white/50">First-year goal</p>
        <p class="mt-1 text-4xl font-semibold text-white">${d.goalUSD} <span class="text-base font-normal text-white/50">USD</span></p>
        <p class="mt-1 text-sm text-white/55">One year of Apple Developer Program membership.</p>

        <div class="mt-6">
          {progress !== null ? (
            <>
              <div class="h-3 overflow-hidden rounded-full bg-white/10" role="progressbar" aria-valuemin="0" aria-valuemax={d.goalUSD} aria-valuenow={d.raisedUSD ?? 0} aria-label="Funding progress">
                <div class="h-full rounded-full bg-gradient-to-r from-blue-500 to-violet-500" style={`width: ${progress}%`}></div>
              </div>
              <p class="mt-2 text-sm text-white/70"><strong class="text-white">${d.raisedUSD}</strong> raised of ${d.goalUSD} ({progress}%){d.raisedAsOf && ` · as of ${d.raisedAsOf}`}{d.provider && `, from ${d.provider} records`}.</p>
            </>
          ) : (
            <>
              <div class="h-3 overflow-hidden rounded-full border border-dashed border-white/20 bg-white/[0.03]" role="img" aria-label="Funding progress not yet reported"></div>
              <p class="mt-2 text-sm text-white/55">Progress will be shown here once it can be confirmed from the donation provider’s records.</p>
            </>
          )}
        </div>

        <div class="mt-8">
          {donate ? (
            <a href={donate} rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-gradient-to-b from-pink-500 to-rose-600 px-6 py-3 font-semibold text-white shadow-lg shadow-rose-900/40 transition hover:brightness-110">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 fill-current"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 5 6.4 5c2 0 3.3 1.1 4.1 2.3h3c.8-1.2 2.1-2.3 4.1-2.3C21 5 23.1 8.4 21.6 11.8 19.5 16.4 12 21 12 21z"/></svg>
              Donate{d.provider ? ` with ${d.provider}` : ""}
            </a>
          ) : import.meta.env.DEV ? (
            <div class="rounded-xl border border-dashed border-amber-400/50 bg-amber-400/[0.06] p-4 text-sm text-amber-100">
              <strong>Setup needed (visible in development only):</strong> no donation account is configured.
              Set <code>donation.provider</code> and <code>donation.url</code> in <code>src/config/site.ts</code>. No button is published until then.
            </div>
          ) : (
            <p class="text-sm text-white/55">Donations will open soon. Thank you for your patience!</p>
          )}
        </div>
        <p class="mt-6 text-xs leading-relaxed text-white/45">
          Donations are voluntary and very much appreciated. They are not a purchase: they don’t buy a subscription, a license,
          support commitments or any guaranteed feature, and QuickDock stays free either way.
        </p>
      </div>
    </div>
  </section>

  <!-- Privacy -->
  <section id="privacy" class="mx-auto max-w-6xl px-5 pt-28">
    <h2 class="section-title text-3xl font-semibold text-white sm:text-4xl">Private by design</h2>
    <p class="mt-4 max-w-2xl text-white/60">QuickDock is sandboxed by macOS and has no permission to use the network. It can only open files and folders you choose.</p>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {privacy.map(([title, text]) => (
        <li class="glass flex gap-4 rounded-2xl p-5">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green-500/15 text-green-400">
            <svg aria-hidden="true" viewBox="0 0 20 20" class="h-3.5 w-3.5 fill-current"><path d="M7.6 13.4 4.2 10l-1.4 1.4 4.8 4.8L17.2 6.6l-1.4-1.4z"/></svg>
          </span>
          <div><h3 class="font-semibold text-white">{title}</h3><p class="mt-1 text-sm text-white/60">{text}</p></div>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-sm"><a class="text-[var(--color-accent)] hover:underline" href={asset("privacy/")}>Read the full privacy policy →</a></p>
  </section>

  <!-- FAQ -->
  <section id="faq" class="mx-auto max-w-3xl px-5 pt-28">
    <h2 class="section-title text-center text-3xl font-semibold text-white sm:text-4xl">Frequently asked questions</h2>
    <div class="mt-10 divide-y divide-white/5 rounded-2xl border border-white/10">
      {faqs.map(([q, a]) => (
        <details class="px-5 py-4">
          <summary class="flex items-center justify-between gap-4 font-medium text-white/90">{q}<span class="chevron text-white/40 transition">›</span></summary>
          <p class="mt-3 text-sm leading-relaxed text-white/60">{a}</p>
        </details>
      ))}
    </div>
    {issues && <p class="mt-6 text-center text-sm text-white/55">Something else? <a class="text-[var(--color-accent)] hover:underline" href={issues}>Open an issue on GitHub</a>.</p>}
  </section>
</Base>
