---
import Base from "../layouts/Base.astro";
import license from "../../../LICENSE?raw";
---
<Base title="License" description="QuickDock is open-source software released under the MIT License.">
  <article class="mx-auto max-w-3xl px-5 pt-16">
    <h1 class="section-title text-4xl font-semibold text-white">License</h1>
    <p class="mt-3 text-white/60">QuickDock is released under the MIT License.</p>
    <pre class="mt-8 whitespace-pre-wrap rounded-2xl border border-white/10 bg-white/[0.03] p-6 text-sm leading-relaxed text-white/75">{license}</pre>
  </article>
</Base>
