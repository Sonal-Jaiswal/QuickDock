---
import { downloadUrl, site, formatBytes } from "../config/site";

interface Props {
  size?: "md" | "lg";
}
const { size = "md" } = Astro.props;
const url = downloadUrl();
const fileSize = formatBytes(site.release.sizeBytes);
const padding = size === "lg" ? "px-6 py-3 text-base" : "px-5 py-2.5 text-sm";
const apple = `<svg aria-hidden="true" viewBox="0 0 24 24" class="h-[1.1em] w-[1.1em] fill-current"><path d="M16.37 12.6c-.02-2.2 1.8-3.26 1.88-3.31-1.03-1.5-2.62-1.7-3.18-1.73-1.35-.14-2.64.8-3.33.8-.69 0-1.74-.78-2.86-.76-1.47.02-2.83.86-3.59 2.17-1.53 2.65-.39 6.58 1.1 8.73.73 1.05 1.6 2.23 2.73 2.19 1.1-.04 1.51-.71 2.84-.71 1.32 0 1.7.71 2.86.69 1.18-.02 1.93-1.07 2.65-2.13.84-1.22 1.18-2.4 1.2-2.46-.03-.01-2.3-.88-2.3-3.48ZM14.2 6.13c.6-.73 1.01-1.75.9-2.76-.87.04-1.92.58-2.54 1.31-.56.64-1.05 1.67-.92 2.66.97.08 1.96-.49 2.56-1.21Z"/></svg>`;
---
{url ? (
  <a href={url} class={`inline-flex items-center gap-2 rounded-full bg-white font-semibold text-black shadow-lg shadow-black/30 transition hover:bg-white/90 ${padding}`}>
    <Fragment set:html={apple} />
    Download for macOS
    {fileSize && <span class="font-normal text-black/50">· {fileSize}</span>}
  </a>
) : (
  <span class={`inline-flex cursor-not-allowed items-center gap-2 rounded-full border border-white/15 bg-white/5 font-medium text-white/60 ${padding}`} aria-disabled="true">
    <Fragment set:html={apple} />
    Download — release not published yet
  </span>
)}
{!url && import.meta.env.DEV && (
  <p class="mt-2 text-xs text-amber-300/90">Setup: set <code>repository.owner</code> in <code>src/config/site.ts</code> once the GitHub repository and release exist.</p>
)}
